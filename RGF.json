{  
"$schema": "https://json-schema.org/draft/2020-12/schema",
"title": "RGF",
"description": "The RNA Graph Desing format",
"type": "object",
"properties": {
    "Metadata":{
        "description": "Metadata about the file",
        "type":"object",
        "properties": {
            "FileType": {
                "description": "The type of the file",
                "type": "string"
            },
            "FileVersion": {
                "description": "The version of the file format",
                "type": "string"
            },
            "Software": {
                "description": "The software that generated the file",
                "type": "string"
            },
            "SoftwareVersion": {
                "description": "The version of the software that generated the file",
                "type": "string"},
            "CreationDate": {
                "description": "The date the file was created",
                "type": "string"
            },
            "CurrentMaxNodeIndex":{"type":"integer","minimum": 0,"default":0},
            "CurrentMaxMotifIndex":{"type":"integer","minimum": 0,"default":0}
        },
        "required": ["FileType", "FileVersion", "CreationDate","CurrentMaxNodeIndex","CurrentMaxMotifIndex"]
        }
        ,
    "Design":{
        "description": "The main graph data",
        "type": "object",
        "properties": {
            "Chains":{"type":"array","minItems": 1},
            "Strand Graph": {
                "description": "The  strand graph or the nucleotide design",
                "type": "array",
                "items": {"$ref": "#/$defs/node"}
            },
            "Motif Graph":{
                "description": "The Motif graph or the motif design",
                "type":"array",
                "items": {"$ref": "#/$defs/motif"}
            },
            "State Diffs":{
                "description": "The different states of the design with the variant element of the graph",
                "type":"array",
                "items": {"$ref": "#/$defs/diff_state"}
            }
        },
        "required": ["Strand Graph"],
        "additionalProperties": false
        },
    "Derived data":{
        "description": "Data that software have derived form the design",
        "type":"object",
        "properties":{
            "Sequence": {
                "description": "The sequence of the design",
                "type": "string"
            },
            "dotBracket": {
                "description": "The dot bracket notation of the design",
                "type": "string"
            }
        }
        },
    "Embeded files":{
        "description": "File that have been attached to the design for easy of transfere",
        "type":"object"
        }
    },
    "required": ["Metadata", "Design"],



    "$defs": {
        "connection":{
            "type":"object",
            "properties": {
                "target_id":{"type":"integer"},
                "target_edge":{"enum":["5p","3p","watson","hoogsteen","sugar","5stack","3stack"],"type":"string"}
                
            },
            "required": ["target_id","target_edge"],
            "additionalProperties": false
        },

        "connections":{
            "type":"object",
            "properties": {
                "5p":{"$ref": "#/$defs/connection"},
                "3p":{"$ref": "#/$defs/connection"},
                "Watson":{"$ref": "#/$defs/connection"},
                "Hoogsteen":{"$ref": "#/$defs/connection"},
                "Sugar":{"$ref": "#/$defs/connection"},
                "5p-stack":{"$ref": "#/$defs/connection"},
                "3p-stack":{"$ref": "#/$defs/connection"}
            },
            "additionalProperties": false
        },
        "node":{
            "type":"object",
            "properties": {
                "id":{"type":"integer"},
                "base":{"type":"string"},
                "connections":{"type":"object","items": {"$ref":"#/$defs/connections"},"minItems": 7},
                "next chain":{"type":"integer"}
            },
            "required": ["id","base","connections"],
            "additionalProperties": false
        },
        "motif":{
            "type":"object",
            "properties": {
                "id":{"type":"integer"},
                "name":{"type":"string"},
                "members":{"type":"array","items": {"$ref": "#/$defs/node"},"minItems": 1},
                "prev":{"type":"integer"},
                "next":{"type":"integer"}
            },
            "required": ["id","name","members","prev","next"],
            "additionalProperties": false
        },
        "diff_state":{
            "type":"array",
            "items": {"$ref": "#/$defs/node"},
            "minItems": 1
        }
    }
}
